{
  "name": "ai-dev-harness-lab",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "AI駆動開発とハーネス設計を学ぶ実験場（Claude: 要件・設計 / Codex: 実装・レビュー）",
  "engines": { "node": ">=20" },
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:docs": "node scripts/check-traceability.mjs",
    "check:owner": "node scripts/check-ownership.mjs",
    "check:approval": "node scripts/check-approval.mjs",
    "check:harness": "node scripts/check-harness.mjs",
    "harness:selftest": "node scripts/harness-selftest.mjs",
    "verify": "bash scripts/verify.sh"
  }
}
